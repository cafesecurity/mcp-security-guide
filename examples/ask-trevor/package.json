{
  "name": "ask-trevor-example",
  "version": "0.1.0",
  "private": true,
  "description": "Teaching example: a small, read-only MCP search server that follows the MCP Security Guide.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx scripts/dev.ts",
    "test": "vitest run",
    "snapshot:check": "tsx scripts/check-tool-snapshot.ts",
    "snapshot:update": "tsx scripts/check-tool-snapshot.ts --update"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
